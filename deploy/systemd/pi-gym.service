[Unit]
Description=Pi Gym FastAPI service
After=network.target

[Service]
Type=simple
User=pi-gym
Group=pi-gym
WorkingDirectory=/opt/pi-gym/app/backend
Environment=GYM_DATABASE_PATH=/var/lib/pi-gym/gym.db
ExecStart=/opt/pi-gym/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8002
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pi-gym

[Install]
WantedBy=multi-user.target
