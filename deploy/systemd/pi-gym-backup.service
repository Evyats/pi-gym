[Unit]
Description=Back up the Pi Gym SQLite database

[Service]
Type=oneshot
User=pi-gym
Group=pi-gym
ExecStart=/bin/bash /opt/pi-gym/app/deploy/backup/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/pi-gym
ReadOnlyPaths=/var/lib/pi-gym
